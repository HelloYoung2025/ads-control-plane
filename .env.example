# 变量名清单——仅示例，值必须来自 Secret Manager，不得写入任何文件
ADS_CP_ENV=
ADS_CP_DATABASE_URL=
ADS_CP_OIDC_ISSUER=

# 领星只读同步通道（本地演示可选；语义详见 docs/runbook-local-demo.md「真实领星通道」）
LX_MCP_KEY=
LX_MCP_URL=
# 同步白名单：允许拉取的店铺 profile id，逗号分隔；缺省空 = 全拒（fail-closed）
ADS_CP_SYNC_PROFILES=
# 每张报表单轮最多拉几页（每页 100 行），缺省 3；截断会如实标注并可续拉
ADS_CP_SYNC_MAX_PAGES=

# 策略面（NEG_EXACT）用真实搜索词源，而不是演示数据。与上面的同步 key 分开：
# 生成候选是 AI 可调用的工具且即席模式无配额，接入真实取数必须是一次显式动作。
ADS_CP_STRATEGY_LX_ENABLED=
# 逐店币种覆盖 "<profile_id>:USD,<profile_id>:EUR"。缺省按站点推出（美元站出美元、
# 欧元站出欧元），而这条推断依赖一个未决前提：spends 是站点本币而非折算口径（DEC-024）。
# 表里没有的站点不猜，该店不进绑定表、对外如实回答「没接数据源」。
ADS_CP_LX_PROFILE_CURRENCY=
# provider_connection_id 的稳定来源（UUID）。不配则每次启动现生一个，
# 于是同一份数据在重启后会得到不同的候选集合冻结 hash。
ADS_CP_LX_CONNECTION_ID=
